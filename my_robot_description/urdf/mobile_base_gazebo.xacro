<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 1. CASTER SURFACE FRICTION OVERRIDE
      Sets low friction (0.1) for the caster wheel.
      'mu1' is forward friction; 'mu2' is side friction.
      Makes it slippery so the robot turns smoothly without tripping.-->
    <gazebo reference="caster_wheel_link">
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <!-- 2. DIFFERENTIAL DRIVE DRIVER & ODOMETRY
      The movement engine. Translates velocity commands into wheel rotations.
      Uses wheel dimensions to calculate how far the robot travels (Odometry).-->
    <gazebo>
        <plugin 
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>base_left_wheel_joint</left_joint>
            <right_joint>base_right_wheel_joint</right_joint>
            <wheel_separation>0.45</wheel_separation>
            <wheel_radius>0.1</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint_link</child_frame_id>
        </plugin>
    </gazebo>

    <!--3. JOINT POSITION TRACKER (ENCODERS)
      Reads active wheel movement inside Gazebo and sends it to ROS.
      Allows RViz to visually animate the spinning wheels.
      Caster is commented out because it is now a static 'fixed' joint.-->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_left_wheel_joint</joint_name>
            <joint_name>base_right_wheel_joint</joint_name>
            <!--<joint_name>base_caster_wheel_joint</joint_name>-->
        </plugin>
    </gazebo>

</robot>