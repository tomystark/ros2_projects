<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- 2. JointPositionController -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>base_arm_forearm_joint</joint_name>
            <p_gain>5.0</p_gain>
        </plugin>
    </gazebo>

<!-- 2. JointPositionController -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>forearm_hand_joint</joint_name>
            <p_gain>3.0</p_gain>
        </plugin>
    </gazebo>    
        
    <!--3. JOINT POSITION TRACKER (ENCODERS)
      Reads active wheel movement inside Gazebo and sends it to ROS.
      Allows RViz to visually animate the spinning wheels.
      Caster is commented out because it is now a static 'fixed' joint.-->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_arm_forearm_joint</joint_name>
            <joint_name>forearm_hand_joint</joint_name>
        </plugin>
    </gazebo>

</robot>